{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stelligenos/data_layout/candidate.schema.json",
  "title": "StelligenOS Candidate CSV row (identity fields)",
  "description": "One row of 10_CANDIDATES/Lnn_*.csv. Level-specific columns may follow the identity fields but MUST NOT introduce context_id or any assessment/decision field. See STELLIGENOS_DATA_LAYOUT_SPEC.v1.0 sec.2.",
  "type": "object",
  "required": [
    "candidate_id",
    "candidate_type",
    "level",
    "canonical_name",
    "status",
    "version",
    "created_at",
    "provenance_ref"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^CAND-L[0-9]{2}-[0-9]{6}$" },
    "candidate_type": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "level": { "type": "string", "enum": ["L00","L01","L02","L03","L04","L05","L06","L07","L08","L09","L10","L11","L12","L13","L14"] },
    "canonical_name": { "type": "string", "minLength": 1 },
    "parent_candidate_id": {
      "description": "lineage pointer; empty string when none",
      "type": "string",
      "pattern": "^(CAND-L[0-9]{2}-[0-9]{6})?$"
    },
    "status": { "type": "string", "enum": ["ACTIVE", "HOLD", "RETIRED"] },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "provenance_ref": { "type": "string", "pattern": "^external:.+" }
  },
  "not": {
    "required": ["context_id"]
  },
  "additionalProperties": true
}
