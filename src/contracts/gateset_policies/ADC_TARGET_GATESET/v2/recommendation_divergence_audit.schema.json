{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stelligenos/gateset/ADC_TARGET_GATESET/v2/recommendation_divergence_audit.schema.json",
  "title": "TGT-05 reviewer recommendation to Candidate Decision audit link",
  "description": "External non-canonical audit artifact. It is retained beside the reviewed Decision and is never a GateSet policy input.",
  "type": "object",
  "required": ["reviewer_record", "approved_assessment", "canonical_decision", "reviewer_recommendation", "candidate_decision", "reviewed_at"],
  "properties": {
    "reviewer_record": {
      "type": "object", "required": ["record_id", "record_version", "artifact_sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^TGT05-REVIEW-[A-Za-z0-9._-]+$"},
        "record_version": {"const": "2.0"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }, "additionalProperties": false
    },
    "approved_assessment": {
      "type": "object", "required": ["assessment_id", "assessment_version", "gate_id", "gate_version", "review_status"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1},
        "assessment_version": {"type": "integer", "minimum": 1},
        "gate_id": {"const": "TGT-05"},
        "gate_version": {"const": "2.0"},
        "review_status": {"const": "HUMAN_APPROVED"}
      }, "additionalProperties": false
    },
    "canonical_decision": {
      "type": "object", "required": ["decision_id", "gateset_id", "gateset_version", "instantiation_id"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "gateset_id": {"const": "ADC_TARGET_GATESET"},
        "gateset_version": {"const": "2.0"},
        "instantiation_id": {"const": "INST-CRC-REFRACTORY-ADC-TARGET-v2"}
      }, "additionalProperties": false
    },
    "reviewer_recommendation": {"enum": ["GO", "HOLD", "KILL"]},
    "candidate_decision": {"enum": ["GO", "HOLD", "MORE_EVIDENCE", "KILL"]},
    "divergence_reason": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{
    "if": {"properties": {"reviewer_recommendation": {"const": "GO"}}, "required": ["reviewer_recommendation"]},
    "then": {"if": {"properties": {"candidate_decision": {"not": {"const": "GO"}}}, "required": ["candidate_decision"]}, "then": {"required": ["divergence_reason"]}}
  }, {
    "if": {"properties": {"reviewer_recommendation": {"const": "HOLD"}}, "required": ["reviewer_recommendation"]},
    "then": {"if": {"properties": {"candidate_decision": {"not": {"const": "HOLD"}}}, "required": ["candidate_decision"]}, "then": {"required": ["divergence_reason"]}}
  }, {
    "if": {"properties": {"reviewer_recommendation": {"const": "KILL"}}, "required": ["reviewer_recommendation"]},
    "then": {"if": {"properties": {"candidate_decision": {"not": {"const": "KILL"}}}, "required": ["candidate_decision"]}, "then": {"required": ["divergence_reason"]}}
  }],
  "additionalProperties": false
}
